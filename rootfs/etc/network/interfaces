# ifupdown-ng configuration. Ethernet (eth*, en*) and Wi-Fi (wlan*) addresses
# are managed by the dhcpcd service; see /etc/dhcpcd.conf for static addresses
# and for excluding an interface from DHCP.
#
# Inspect the resolved configuration: ifquery wlan0
# Start / stop an interface: ifup wlan0 / ifdown wlan0

auto lo
iface lo inet loopback

# Wi-Fi: add credentials to the referenced file, then uncomment auto below
# or run ifup wlan0. ifupdown starts wpa_supplicant; dhcpcd obtains the
# address once the link is associated. ifdown wlan0 stops wpa_supplicant.
# The installed executor does not support the wpa-conf option.
# Do not enable a separate wpa_supplicant service for this interface.
#
# Add this WPA-PSK example to /etc/wpa_supplicant/wpa_supplicant.conf,
# keeping its existing ctrl_interface and update_config settings:
# network={
#     ssid="YOUR_SSID"
#     psk="YOUR_PASSPHRASE"
# }
# Keep that file private: chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
# auto wlan0
iface wlan0 inet manual
    use wifi
    wifi-config-path /etc/wpa_supplicant/wpa_supplicant.conf

# Interface excluded from dhcpcd (denyinterfaces in /etc/dhcpcd.conf) with a
# static address managed here; apply with: rc-service dhcpcd restart; ifup eth1
# auto eth1
# iface eth1 inet static
#     address 192.168.1.100/24
#     gateway 192.168.1.1

# Additional files use the same syntax, for example interfaces.d/usb0.
source /etc/network/interfaces.d/*
